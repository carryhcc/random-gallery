<?xml version="1.0" encoding="utf-8"?>
<!--
  iOS Squircle / Super-ellipse 风格自适应图标前景
  画幅：108x108，中心严格为 (54, 54)
  iOS 风格主图标块：48x48 正方形圆角平滑矩形 (x: 30..78, y: 30..78, r: 12)，彻底杜绝拉伸/椭圆扁平感
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. 外层柔和阴影/景深背板 (48x48，带轻微下沉与透明度) -->
    <path
        android:pathData="M30,32 h48 a13,13 0 0 1 13,13 v22 a13,13 0 0 1 -13,13 h-48 a13,13 0 0 1 -13,-13 v-22 a13,13 0 0 1 13,-13 z"
        android:fillColor="#33000000" />

    <!-- 2. iOS 风格圆角方形主卡片 (48x48，居中于 54,54，圆角 12dp，纯白高光相框) -->
    <path
        android:pathData="M30,30 h48 a12,12 0 0 1 12,12 v24 a12,12 0 0 1 -12,12 h-48 a12,12 0 0 1 -12,-12 v-24 a12,12 0 0 1 12,-12 z"
        android:fillColor="#FFFFFF" />

    <!-- 3. iOS 内部渐变画卷核心 (42x42，正方形圆角 9dp，小红书珊瑚红与暖阳渐变) -->
    <path
        android:pathData="M33,33 h42 a9,9 0 0 1 9,9 v24 a9,9 0 0 1 -9,9 h-42 a9,9 0 0 1 -9,-9 v-24 a9,9 0 0 1 9,-9 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="33"
                android:startY="33"
                android:endX="75"
                android:endY="75"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFF3F5" />
                <item android:offset="0.5" android:color="#FFE8EC" />
                <item android:offset="1.0" android:color="#FFD6DD" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 4. 居中光芒朝阳 (圆心 64, 43，正圆半径 4.5dp，严格 1:1 绝不扁平) -->
    <path
        android:pathData="M64,43 a4.5,4.5 0 1 1 0,-9 a4.5,4.5 0 1 1 0,9 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="59.5"
                android:startY="34"
                android:endX="68.5"
                android:endY="43"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFB300" />
                <item android:offset="1.0" android:color="#FF6F00" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 5. 远山画卷层 (极光蓝) -->
    <path
        android:pathData="M49,75 L58,58 C59.5,55.5 62.5,55.5 64,58 L75,75 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="49"
                android:startY="56"
                android:endX="75"
                android:endY="75"
                android:type="linear">
                <item android:offset="0.0" android:color="#4A90D9" />
                <item android:offset="1.0" android:color="#1A77FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 6. 近山画卷层 (小红书珊瑚红) -->
    <path
        android:pathData="M33,75 L45,52 C46.5,49.5 49.5,49.5 51,52 L63,75 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="33"
                android:startY="50"
                android:endX="63"
                android:endY="75"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF5E62" />
                <item android:offset="1.0" android:color="#FF2442" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 7. iOS 玻璃高光反光层 (顶部圆弧微光，增加晶莹通透感) -->
    <path
        android:pathData="M33,33 h42 a9,9 0 0 1 9,9 v8 C68,46 45,46 33,52 v-11 a9,9 0 0 1 9,-9 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="33"
                android:endX="54"
                android:endY="52"
                android:type="linear">
                <item android:offset="0.0" android:color="#66FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 8. 右上角灵感探索十字星 (Sparkle) -->
    <path
        android:pathData="M76,28 C76,25 79,22 79,22 C79,22 79,25 82,25 C79,25 79,28 79,28 C79,28 76,25 76,28 Z"
        android:fillColor="#FFD54F" />

</vector>
